# DevPulse Platform Environment Configuration Example

# Django Backend Settings
DJANGO_SECRET_KEY=change-me-in-production-environments-super-secret-key-4920
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (Defaults to SQLite for local development; uncomment for PostgreSQL)
# DATABASE_URL=postgres://devpulse_user:password@localhost:5432/devpulse_db

# AI Intelligence Pipeline Configuration
# Providers: 'heuristic' (zero API keys required, works out of the box), 'gemini', 'openai', 'anthropic'
DEVPULSE_AI_PROVIDER=heuristic

# Optional External AI API Keys (Optional - DevPulse heuristic engine works fully without them)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8001/api/v1
PORT=3000
